# ============================================================================
# PLANTILLA DE VARIABLES DE ENTORNO
# ============================================================================
# Este archivo SÍ se versiona: es el que le dice al que clona el repo qué
# variables necesita. No lleva valores reales, solo los nombres y un ejemplo.
#
# Para arrancar:   cp .env.example .env     (en Windows: copy .env.example .env)
#
# El .env que sale de acá NO se versiona: está en el .gitignore del repo.
# ============================================================================

# ── Servidor ────────────────────────────────────────────────────────────────
PORT=3000

# ── Base de datos ───────────────────────────────────────────────────────────
# Hasta la unidad 8 esto estaba escrito en mikro-orm.config.ts. Acá sale del
# código: cada persona del equipo tiene su MySQL con su propia contraseña.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=dsw_auth
DB_USER=root
DB_PASSWORD=root

# ── JWT ─────────────────────────────────────────────────────────────────────
# El secret de abajo es de ejemplo y es PÚBLICO: está en un repo de GitHub.
# Generá el tuyo con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=cambiame-por-uno-generado-al-azar-de-al-menos-32-caracteres
JWT_EXPIRES_IN=1h

# ── CORS ────────────────────────────────────────────────────────────────────
# Desde qué origen se permite llamar a esta API desde un navegador.
# El front de Angular de la materia levanta en 4200; el ejemplo 9.4, en 5173.
CORS_ORIGIN=http://localhost:5173
