{
  "name": "11.3-ci-github-actions",
  "version": "1.0.0",
  "type": "module",
  "description": "El servidor que corre los tests antes de publicar y se niega a subir una versión rota",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "check": "tsc --noEmit",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:cobertura": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage"
  },
  "engines": {
    "node": ">=20 <23"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "express": "4.18.2"
  },
  "devDependencies": {
    "@jest/globals": "30.4.1",
    "@types/express": "4.17.21",
    "@types/node": "20.11.30",
    "@types/supertest": "6.0.3",
    "jest": "30.4.2",
    "supertest": "7.2.2",
    "ts-jest": "29.4.12",
    "tsx": "4.23.8",
    "typescript": "5.4.5"
  }
}
