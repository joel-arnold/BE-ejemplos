# ============================================================================
# PLANTILLA DE VARIABLES DE ENTORNO
# ============================================================================
# Este archivo SÍ se versiona: es el que le dice al que clona el repositorio
# qué variables necesita. No lleva valores reales, solo nombres y ejemplos.
#
# Para arrancar en tu máquina:  cp .env.example .env   (Windows: copy)
#
# El .env que sale de acá NO se versiona: está en el .gitignore.
#
# En producción NO hay archivo .env. Estas mismas variables se cargan a mano en
# el panel de la plataforma (en Render: Environment), y el proceso las recibe
# ya puestas en el ambiente. El código no cambia: dotenv no encuentra archivo,
# no falla, y sigue con lo que ya haya.
# ============================================================================

# ── Ambiente ────────────────────────────────────────────────────────────────
# development | test | production
# En producción esto cambia tres cosas: el ORM deja de loguear cada consulta,
# el errorHandler deja de mandar el detalle del error al cliente, y las
# migraciones se aplican al arrancar.
NODE_ENV=development

# ── Servidor ────────────────────────────────────────────────────────────────
# En tu máquina, 3000. En la nube esta variable la pone la plataforma y hay que
# usar la que te dan: NO la escribas a mano en el panel de Render.
PORT=3000

# ── Base de datos ───────────────────────────────────────────────────────────
# Estos valores son los de tu MySQL local.
#
# En producción los cinco los da el proveedor de la base (Aiven, Neon, ...) y
# ninguno se parece a estos: el host es un dominio largo terminado en
# .aivencloud.com, el puerto no es 3306, y el usuario no es root.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=dsw_deploy
DB_USER=root
DB_PASSWORD=root

# ── Certificado de la base (solo producción) ────────────────────────────────
# Una base gestionada rechaza las conexiones sin TLS. El proveedor publica el
# certificado de su autoridad certificante (ca.pem) en el panel; se pega acá
# entero, incluidas las líneas BEGIN y END.
#
# En local se deja vacío o directamente comentado: un MySQL en localhost no usa
# TLS y con esta variable puesta la conexión falla.
#
# DB_SSL_CA="-----BEGIN CERTIFICATE-----\nMIIEQTCCAqmgAwIBAgIU...\n-----END CERTIFICATE-----\n"

# ── JWT ─────────────────────────────────────────────────────────────────────
# El secret de abajo es de ejemplo y es PÚBLICO: está en un repositorio de
# GitHub. Generá el tuyo con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Y en producción usá OTRO, distinto al de desarrollo. Si son el mismo, un
# token firmado en tu máquina abre la puerta del servidor de verdad.
JWT_SECRET=cambiame-por-uno-generado-al-azar-de-al-menos-32-caracteres
JWT_EXPIRES_IN=1h

# ── CORS ────────────────────────────────────────────────────────────────────
# Desde qué orígenes se permite llamar a esta API desde un navegador.
# Ahora es una LISTA separada por comas: el front de producción, las previews,
# y localhost para poder desarrollar el front contra la API de verdad.
#
# En producción quedaría algo así:
#   CORS_ORIGIN=https://mi-tp.vercel.app,http://localhost:4200
CORS_ORIGIN=http://localhost:4200
