{
  "name": "11.1-build-produccion",
  "version": "1.0.0",
  "type": "module",
  "description": "De tsx a dist: el build, qué se sube al servidor y qué no",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "check": "tsc --noEmit",
    "limpiar": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\""
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [],
