# Plantilla de variables. En este ejemplo son solo dos y ninguna es secreta.
#
# Para probar local:  cp .env.example .env   (Windows: copy .env.example .env)
#
# Ojo: este proyecto NO usa dotenv a propósito, para que se vea que las
# variables de entorno son de Node y no de una librería. Para probarlas:
#
#   Windows (PowerShell):  $env:PORT=4000; npm start
#   Linux / Mac:           PORT=4000 npm start

PORT=3000
NODE_ENV=development
