{
  "name": "10.4-api-supertest",
  "version": "1.0.0",
  "type": "module",
  "description": "Tests de integración de la API con supertest: rutas, tokens y códigos HTTP, sin base y sin puerto",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:cobertura": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "check": "tsc --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "express": "4.18.2",
    "jsonwebtoken": "9.0.3"
  },
  "devDependencies": {
    "@jest/globals": "30.4.1",
    "@types/express": "4.17.21",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "20.11.30",
    "@types/supertest": "6.0.3",
    "jest": "30.4.2",
    "supertest": "7.2.2",
    "ts-jest": "29.4.12",
    "tsx": "4.23.8",
    "typescript": "5.4.5"
  }
}
